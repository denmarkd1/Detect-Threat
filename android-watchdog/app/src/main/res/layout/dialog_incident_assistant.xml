<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="4dp">

    <TextView
        android:id="@+id/incidentAssistantQueueLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:textColor="@color/text_primary"
        android:textSize="13sp" />

    <LinearLayout
        android:id="@+id/incidentAssistantSectionsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/incidentAssistantApplyButton"
        style="@style/Widget.RealynWatchdog.Button.RaisedAction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/incident_assistant_apply_choice"
        android:textAlignment="center"
        app:iconGravity="textStart" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/incidentAssistantGuideButton"
        style="@style/Widget.RealynWatchdog.Button.RaisedAction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/incident_assistant_guide_choice"
        android:textAlignment="center"
        app:iconGravity="textStart" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/incidentAssistantSkipButton"
        style="@style/Widget.RealynWatchdog.Button.RaisedAction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/incident_assistant_skip_choice"
        android:textAlignment="center"
        app:iconGravity="textStart" />
</LinearLayout>
