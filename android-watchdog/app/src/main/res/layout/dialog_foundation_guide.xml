<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/foundationGuideDialogRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingTop="4dp">

    <ScrollView
        android:id="@+id/foundationGuideMessageScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fadeScrollbars="false"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls"
        android:scrollbarStyle="insideInset">

        <TextView
            android:id="@+id/foundationGuideMessageLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="2dp"
            android:textIsSelectable="true"
            android:textSize="15sp" />
    </ScrollView>

    <LinearLayout
        android:id="@+id/foundationGuideActionsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/foundationGuidePrimaryButton"
                style="@style/Widget.RealynWatchdog.Button.RaisedUniformPair"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:textAlignment="center" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/foundationGuideSecondaryButton"
                style="@style/Widget.RealynWatchdog.Button.RaisedUniformPair"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:textAlignment="center" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/foundationGuideTertiaryButton"
            style="@style/Widget.RealynWatchdog.Button.RaisedUniformPair"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textAlignment="center" />
    </LinearLayout>
</LinearLayout>
