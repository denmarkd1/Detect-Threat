{
  "version": 1,
  "disclosure": "Retail-safe deterministic guide rules. Phase 1 does not use screenshots, accessibility capture, or autonomous taps.",
  "flows": [
    {
      "id": "foundation_autofill_miui",
      "title": "Set up autofill first",
      "total_steps": 5,
      "initial_state_id": "search",
      "states": [
        {
          "id": "search",
          "step_number": 1,
          "current_target": "Open Settings and search for Password Manager or Autofill service.",
          "assistant_hint": "Tap the button that matches what you see. This guide only changes after your confirmation.",
          "anchors": [
            {
              "id": "passwords_accounts",
              "label": "Passwords & accounts",
              "next_state_id": "open_autofill_service",
              "match_any": ["Passwords & accounts"]
            },
            {
              "id": "accounts_sync_android_auto",
              "label": "Accounts & sync / Android Auto",
              "next_state_id": "dead_end_warning",
              "match_any": ["Accounts & sync", "Android Auto"]
            },
            {
              "id": "google_password_manager",
              "label": "Google Password Manager",
              "next_state_id": "google_password_manager",
              "match_any": ["Google Password Manager", "Password Manager"]
            },
            {
              "id": "autofill_service",
              "label": "Autofill service",
              "next_state_id": "pick_provider",
              "match_any": ["Autofill service"]
            }
          ]
        },
        {
          "id": "dead_end_warning",
          "step_number": 2,
          "current_target": "Back out. Open Passwords & accounts > Autofill service > Google.",
          "assistant_hint": "Do not continue through Accounts & sync or Android Auto on current Xiaomi builds.",
          "anchors": [
            {
              "id": "passwords_accounts",
              "label": "Passwords & accounts",
              "next_state_id": "open_autofill_service",
              "match_any": ["Passwords & accounts"]
            },
            {
              "id": "google_password_manager",
              "label": "Google Password Manager",
              "next_state_id": "google_password_manager",
              "match_any": ["Google Password Manager", "Password Manager"]
            }
          ]
        },
        {
          "id": "open_autofill_service",
          "step_number": 3,
          "current_target": "Open Passwords & accounts > Autofill service > Google.",
          "assistant_hint": "If Xiaomi redirects into Google, use the Google fallback route below.",
          "anchors": [
            {
              "id": "autofill_service",
              "label": "Autofill service",
              "next_state_id": "pick_provider",
              "match_any": ["Autofill service"]
            },
            {
              "id": "google_password_manager",
              "label": "Google Password Manager",
              "next_state_id": "google_password_manager",
              "match_any": ["Google Password Manager", "Password Manager"]
            }
          ]
        },
        {
          "id": "google_password_manager",
          "step_number": 4,
          "current_target": "Open Google Password Manager or Autofill with Google, then look for the autofill provider/service setting.",
          "assistant_hint": "If you only see Preferences, open it and keep looking for Autofill service or the default password manager setting.",
          "anchors": [
            {
              "id": "preferences",
              "label": "Preferences",
              "next_state_id": "preferences",
              "match_any": ["Preferences"]
            },
            {
              "id": "autofill_service",
              "label": "Autofill service",
              "next_state_id": "pick_provider",
              "match_any": ["Autofill service"]
            }
          ]
        },
        {
          "id": "preferences",
          "step_number": 4,
          "current_target": "In Preferences, open Autofill service or the default password manager/provider setting.",
          "assistant_hint": "Use the entry that controls the active autofill provider.",
          "anchors": [
            {
              "id": "autofill_service",
              "label": "Autofill service",
              "next_state_id": "pick_provider",
              "match_any": ["Autofill service"]
            }
          ]
        },
        {
          "id": "pick_provider",
          "step_number": 5,
          "current_target": "Select Google or your chosen password manager as the Autofill service/provider.",
          "assistant_hint": "Only confirm after the provider stays selected.",
          "anchors": [
            {
              "id": "provider_selected",
              "label": "Provider selected",
              "next_state_id": "return_recheck",
              "match_any": ["Provider selected"]
            }
          ]
        },
        {
          "id": "return_recheck",
          "step_number": 5,
          "current_target": "Return to DT Guardian and tap Recheck now.",
          "assistant_hint": "Use Recheck now to verify the setup instead of restarting Scan breaches.",
          "complete": true,
          "anchors": []
        }
      ]
    },
